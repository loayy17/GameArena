# Copy this file to `.env` and replace placeholder values.
# Never commit the real `.env` file.

# PostgreSQL
POSTGRES_USER=gamearena
POSTGRES_PASSWORD=change-this-password
POSTGRES_DB=gamearena

# JWT — use at least 32 random characters
JWT__Token=CHANGE_ME_to_a_long_random_secret_key_at_least_32_chars
JWT__Issuer=GameArena
JWT__Audience=GameArena

# Email delivery (Brevo). Required to send verification and password-reset emails.
# Leave the password empty only if you do not need email during local testing.
EmailSettings__Email=noreply@localhost
EmailSettings__Password=

# Browser origin allowed by CORS (Docker HTTPS reverse proxy)
Cors__AllowedOrigins__0=https://localhost

# Frontend API origin. Leave empty when the app is served through nginx (same origin).
# For local `npm run dev` without Docker, set this to your backend URL, for example:
# NEXT_PUBLIC_API_URL=https://localhost
NEXT_PUBLIC_API_URL=
