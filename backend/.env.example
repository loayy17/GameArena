# GameArena Backend - Environment Variables
# Copy this file to .env and update values as needed
# The backend loads .env automatically via DotNetEnv
#
# For production (Render): set these as environment variables in the dashboard
# For local development: use the .env file (git-ignored)

# Database (Neon PostgreSQL)
ConnectionStrings__DefaultConnection=Host=ep-xxxxx.region.aws.neon.tech;Port=5432;Database=neondb;Username=neondb_owner;Password=xxx;SSL Mode=Require;Trust Server Certificate=true;

# Email Settings (Brevo/Sendinblue)
EmailSettings__Email=your-email@example.com
EmailSettings__Host=smtp-relay.brevo.com
EmailSettings__Port=587
EmailSettings__Password=your-brevo-api-key

# JWT Settings
JWT__Token=your-super-secret-jwt-key-min-32-chars
JWT__Issuer=GameArena
JWT__Audience=GameArenaUsers

# CORS (JSON array of allowed origins)
Cors__AllowedOrigins=https://game-arena-plum.vercel.app
